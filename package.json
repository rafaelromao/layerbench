{
  "name": "layerbench",
  "private": true,
  "version": "0.2.0",
  "description": "Keyboard layout analyzer with faithful ZMK layer semantics (multi-alpha-layer aware)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "build": "pnpm -r --filter @layerbench/core run build && pnpm --filter @layerbench/web run build",
    "dev": "pnpm --filter @layerbench/web run dev",
    "corpora": "pnpm --filter @layerbench/corpora run build",
    "corpora:fetch": "pnpm --filter @layerbench/corpora run fetch-code",
    "corpora:extract": "pnpm --filter @layerbench/corpora run extract-code",
    "corpora:research": "pnpm --filter @layerbench/corpora run research",
    "bench": "BENCH=1 pnpm --filter @layerbench/core run test",
    "goldens": "pnpm --filter @layerbench/core run goldens",
    "generate": "pnpm --filter @layerbench/core run generate",
    "keymap": "pnpm --filter @layerbench/core run keymap",
    "languages": "pnpm --filter @layerbench/core run languages",
    "library-edit": "pnpm --filter @layerbench/core run library-edit",
    "library-retitle": "pnpm --filter @layerbench/core run library-retitle",
    "community-cleanup": "pnpm --filter @layerbench/core run community-cleanup",
    "pr-title": "test -n \"$PR_TITLE\" || { echo \"Set PR_TITLE to the title to check.\"; exit 1; }; pnpm --filter @layerbench/core run pr-title"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
