{
  "name": "@layoutmaster/corpora",
  "version": "0.2.0",
  "description": "Builds the shipped corpus samples and manifests served by the web app",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "esbuild src/build.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/build.mjs --log-level=warning && node dist/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'no tests'",
    "fetch": "esbuild src/fetch.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/fetch.mjs --log-level=warning && node dist/fetch.mjs",
    "generate": "esbuild src/generate.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/generate.mjs --log-level=warning && node dist/generate.mjs"
  },
  "dependencies": {
    "@layoutmaster/core": "workspace:*"
  }
}
